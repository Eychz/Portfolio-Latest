NODE_ENV=development
PORT=4000

# PostgreSQL connection string used by Prisma
DATABASE_URL=postgresql://portfolio:portfolio@localhost:5432/portfolio?schema=public

# Redis is optional: leave empty to run without caching
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=300

# Comma-separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Use a long random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# Used by `npm run db:seed` to create the first admin account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
